<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh.
  Package names: tools/venv/bin/python -I tools/tv.py 'pm list packages'
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.plexapp.android</item>
        <item>com.google.android.youtube.tv</item>
        <item>tv.twitch.android.app</item>
        <item>com.comedybox.app</item>
    </string-array>

    <!-- Remote app buttons, KEY=package. Needs Settings → Accessibility → TV Home remote buttons on.
         Chromecast with Google TV remote: YouTube = BUTTON_3, Netflix = BUTTON_4. Empty to leave them alone. -->
    <string-array name="remote_buttons">
        <item>BUTTON_3=com.google.android.youtube.tv</item>
        <item>BUTTON_4=com.plexapp.android</item>
    </string-array>

    <!-- Weather under the clock (Open-Meteo, no key). Empty latitude to turn it off. Bucharest. -->
    <string name="weather_latitude" translatable="false">44.4268</string>
    <string name="weather_longitude" translatable="false">26.1025</string>

    <!-- Never shown as tiles: system helpers, and the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.google.android.tv.axel</item>
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- Show the Inputs pill (HDMI/AV/Live TV). Off for streaming sticks such as Chromecast. -->
    <bool name="show_inputs">false</bool>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false"></string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>
</resources>
