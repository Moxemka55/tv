<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh.
  Package names: tools/venv/bin/python -I tools/tv.py 'pm list packages'
-->
<resources>
    <!-- Default dock apps, left to right. Apps that aren't installed are skipped. Once you edit the dock on
         the TV (hold OK on a tile) the TV's own copy wins; clear the launcher's data to go back to this. -->
    <string-array name="dock_apps">
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
    </string-array>

    <!-- Never shown as tiles: system helpers, and the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
        <item>com.tcl.suspension</item>
        <item>com.tcl.t_solo</item>
        <item>com.tcl.dashboard</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.tcl.suspension</string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>
    <!-- Minutes between wallpaper changes on the home screen, and seconds per photo in the screensaver. -->
    <integer name="wallpaper_minutes">10</integer>
    <integer name="screensaver_seconds">45</integer>

    <!-- Most recently used apps first in the grid (needs usage access, see Usage.java); A to Z otherwise. -->
    <bool name="sort_grid_by_recent">true</bool>

    <!-- Most apps in the dock; "Add to dock" says so when it's full. -->
    <integer name="max_dock_apps">9</integer>

    <!-- Vendor "screen off, keep sound" screen for the Quick settings panel, as package/activity. Empty to
         leave the row out. Also add its package to <queries> in AndroidManifest.xml.
         Realtek-based sets (Kodak, some Thomson/Blaupunkt): com.realtek.slices/com.realtek.tv.settings.activity.SoundOnlyActivity -->
    <string name="screen_off_component" translatable="false"></string>
</resources>
